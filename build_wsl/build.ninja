build CMakeFiles/generate_api_docs | ${cmake_ninja_workdir}CMakeFiles/generate_api_docs: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_api_docs.py
  DESC = 运行 gen_api_docs.py


#############################################
# Custom command for CMakeFiles/generate_single_header

build CMakeFiles/generate_single_header | ${cmake_ninja_workdir}CMakeFiles/generate_single_header: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_single_header.py
  DESC = 运行 gen_single_header.py


#############################################
# Custom command for CMakeFiles/generate_gallery

build CMakeFiles/generate_gallery | ${cmake_ninja_workdir}CMakeFiles/generate_gallery: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_gallery.py --build-dir /mnt/c/termchart/build_wsl
  DESC = 运行 gen_gallery.py


#############################################
# Custom command for CMakeFiles/check_layers

build CMakeFiles/check_layers | ${cmake_ninja_workdir}CMakeFiles/check_layers: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/check_layers.py
  DESC = 分层规则校验（禁止边 → 收窄边 → 层号）


#############################################
# Custom command for CMakeFiles/check_header_only

build CMakeFiles/check_header_only | ${cmake_ninja_workdir}CMakeFiles/check_header_only: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/check_header_only.py
  DESC = 头文件自洽性校验（include/ ↔ src/ 同路径同名）


#############################################
# Custom command for CMakeFiles/check_generated

build CMakeFiles/check_generated | ${cmake_ninja_workdir}CMakeFiles/check_generated: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_unicode_tables.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_grapheme_tables.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_braille_table.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_turbo_table.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_dsl_samples.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_fixtures.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_module_graph.py --check && /usr/bin/python3 /mnt/c/termchart/tools/gen_single_header.py --check
  DESC = 生成物与生成器一致（无 diff）


#############################################
# Custom command for CMakeFiles/check_headers

build CMakeFiles/check_headers | ${cmake_ninja_workdir}CMakeFiles/check_headers: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/check_headers.py --compiler /usr/bin/c++ --include /mnt/c/termchart/include
  DESC = 每头独立编译（自包含性）


#############################################
# Custom command for CMakeFiles/generate_golden

build CMakeFiles/generate_golden | ${cmake_ninja_workdir}CMakeFiles/generate_golden: CUSTOM_COMMAND || libtermchart.a tests/termchart_tests
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_golden.py /mnt/c/termchart/build_wsl/tests/termchart_tests
  DESC = 重新生成 tests/golden 快照


#############################################
# Custom command for CMakeFiles/single_header

build CMakeFiles/single_header | ${cmake_ninja_workdir}CMakeFiles/single_header: CUSTOM_COMMAND
  COMMAND = cd /mnt/c/termchart && /usr/bin/python3 /mnt/c/termchart/tools/gen_single_header.py
  DESC = 生成 single_include/termchart.hpp

# =============================================================================
# Write statements declared in CMakeLists.txt:
# /mnt/c/termchart/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for EXECUTABLE target termchart_tests


#############################################
# Order-only phony target for termchart_tests

build cmake_object_order_depends_target_termchart_tests: phony || cmake_object_order_depends_target_termchart

build tests/CMakeFiles/termchart_tests.dir/main.cpp.o: CXX_COMPILER__termchart_tests_unscanned_Debug /mnt/c/termchart/tests/main.cpp || cmake_object_order_depends_target_termchart_tests
  DEFINES = -DTERMCHART_FIXTURES_DIR=\"/mnt/c/termchart/tests/fixtures\" -DTERMCHART_GOLDEN_DEFAULT_DIR=\"/mnt/c/termchart/tests/../tests/golden\" -DTERMCHART_MAX_LOG_LEVEL=5 -DTERMCHART_STATIC
  DEP_FILE = tests/CMakeFiles/termchart_tests.dir/main.cpp.o.d
  FLAGS = -g -std=gnu++20 -Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor -Wold-style-cast -Wcast-align -Wunused -Woverloaded-virtual -Wconversion -Wsign-conversion -Wdouble-promotion -Wformat=2 -Wno-unused-parameter
  INCLUDES = -I/mnt/c/termchart/tests -I/mnt/c/termchart/tests/.. -I/mnt/c/termchart/include -isystem /mnt/c/termchart/tests/../third_party/doctest
  OBJECT_DIR = tests/CMakeFiles/termchart_tests.dir
  OBJECT_FILE_DIR = tests/CMakeFiles/termchart_tests.dir
  TARGET_COMPILE_PDB = tests/CMakeFiles/termchart_tests.dir/
  TARGET_PDB = tests/termchart_tests.pdb


{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TERMCHART_BUILD_TESTS": "ON",
        "TERMCHART_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TERMCHART_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "TSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TERMCHART_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TERMCHART_ENABLE_COVERAGE": "ON"
      }
    },

    {
      "name": "ninja",
      "inherits": "base",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "fuzz",
      "inherits": "ninja",
      "displayName": "Fuzz targets (Ninja, TERMCHART_ENABLE_FUZZING)",
      "cacheVariables": {
        "TERMCHART_BUILD_EXAMPLES": "OFF",
        "TERMCHART_ENABLE_FUZZING": "ON"
      }
    },
    {
      "name": "ninja-release",
      "inherits": "base",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm",
      "inherits": "base",
      "displayName": "WASM (Emscripten)",
      "generator": "Ninja",
      "environment": {
        "EM_COMPILER_WRAPPER": "ccache"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "TERMCHART_BUILD_WASM": "ON",
        "TERMCHART_BUILD_TESTS": "OFF",
        "TERMCHART_BUILD_EXAMPLES": "OFF",
        "TERMCHART_BUILD_BENCH": "OFF"
      }
    },

    {
      "name": "analyze",
      "inherits": "ninja",
      "displayName": "Static analysis (clang-tidy + cppcheck)",
      "cacheVariables": {
        "TERMCHART_ENABLE_CLANG_TIDY": "ON",
        "TERMCHART_ENABLE_CPPCHECK": "ON"
      }
    },

    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "MinGW Makefiles"
    },
    {
      "name": "debug-windows",
      "inherits": "windows-base",
      "displayName": "Debug (MinGW)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-windows",
      "inherits": "windows-base",
      "displayName": "Release (MinGW)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo-windows",
      "inherits": "windows-base",
      "displayName": "RelWithDebInfo (MinGW)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "ninja",
      "configurePreset": "ninja"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "analyze",
      "configurePreset": "analyze"
    },
    {
      "name": "debug-windows",
      "configurePreset": "debug-windows"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows"
    },
    {
      "name": "relwithdebinfo-windows",
      "configurePreset": "relwithdebinfo-windows"
    }
  ],
  "testPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-windows",
      "configurePreset": "debug-windows",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

# CMake / 构建产物（绝不入库）
# 体积实测：19 个 build 目录合计 3.96 GB（单目录 250–650 MB，含 asan/cov 插桩产物），
# 而整个源码树只有 8.3 MB。2026-10-13 已全清一次。
build/
build-*/
cmake-build-*/
out/
CMakeUserPresets.json
# WSL 侧构建目录：bc8f005 误提交过整树（仅解除跟踪，物理目录保留在磁盘上）
build_wsl/

# 编译中间产物与二进制
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# IDE / 编辑器
.vs/
.vscode/
.idea/
.cache/
compile_commands.json
*.user
*.swp

# Python 缓存（本仓库 tools/*.py 生成器）
__pycache__/
*.pyc

# 根目录的一次性输出重定向（终端截图/演示输出）。注意：a.txt 与 shot_*.txt
# 曾经被误提交进版本库，加规则对**已跟踪**文件无效——要清理得先
# `git rm --cached a.txt shot_*.txt` 再提交。
/a.txt
/shot_*.txt
# 同上，PDF/PNG 导出与截图的临时落点（示例跑一遍就会生成，不该出现在 git status 里）
/a.pdf
/a.png
# showcase/ 下的一次性脚本（并行会话产物，统一以 _ 开头，扩展名不限）
/showcase/_*

# 测试与覆盖率产物
*.gcda
*.gcno
coverage/
Testing/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 文档站点产物（mkdocs.yml → site/）
site/
docs/_build/

# 合并/补丁残留
*.orig
*.rej
*.bak

# 编码示例/测试的一次性产物：落盘供 ffmpeg / PIL 交叉校验，不入库
# （WebP / GIF / MP4 / HEVC / H.264 等，由 tests / examples 写在工作目录）
/tc_*.webp
/tc_*.gif
/tc_*.png
/tc_*.mp4
/tc_*.264
/tc_*.265
/tc_api_*.gif
/tc_h264.*
/tc_hevc.*
/tc_mp4_ffprobe.mp4
/ref.webp
/out.webp
/build_mp4.log
# vendored libwebp 源码压缩包（自写 VP8L 编码器零依赖，不实际编译它）
/libwebp-*.zip

# 编辑器本地覆盖
.clangd
.clang-tidy-local
CMakeUserPresets.local.json

# 并行 Agent 会话产物（不入库）
.codebuddy/
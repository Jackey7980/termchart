# CMake / 构建产物（绝不入库：build/ 可达 ~125 MB）
build/
build-*/
cmake-build-*/
out/
CMakeUserPresets.json

# 编译中间产物与二进制
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# IDE / 编辑器
.vs/
.vscode/
.idea/
.cache/
compile_commands.json
*.user
*.swp

# Python 缓存（本仓库 tools/*.py 生成器）
__pycache__/
*.pyc

# 根目录的一次性输出重定向（终端截图/演示输出）。注意：a.txt 与 shot_*.txt
# 曾经被误提交进版本库，加规则对**已跟踪**文件无效——要清理得先
# `git rm --cached a.txt shot_*.txt` 再提交。
/a.txt
/shot_*.txt

# 测试与覆盖率产物
*.gcda
*.gcno
coverage/
Testing/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini